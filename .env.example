VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=

# Chat uses Vercel AI Gateway. On Vercel, OIDC is automatic.
# Locally: vercel env pull .env.local
# Optional fallback if OIDC is unavailable:
# AI_GATEWAY_API_KEY=

# --- DrJadav storefront (client + /api/chat) ---
# Also add these on the Vercel project so the chat function sees them.

# Consult offer (defaults: 45 minutes, 250 GBP if unset)
VITE_CONSULT_MINUTES=45
VITE_CONSULT_PRICE=250
VITE_CONSULT_CURRENCY=GBP

# Google Calendar appointment schedule URL (https://calendar.google.com/...)
VITE_CALENDAR_URL=

# Stripe Payment Link for the consult (https://buy.stripe.com/...)
VITE_STRIPE_CONSULT_URL=

# Gumroad product URLs. Empty or "coming-next-week" = not for sale yet.
# Never put Amazon URLs here.
VITE_GUMROAD_BUILD_BEFORE_YOU_SCALE=
VITE_GUMROAD_DECIDE_THEN_BUILD=
VITE_GUMROAD_DELIVER_VALUE=
VITE_GUMROAD_DHARMA_IN_THE_DARK=
VITE_GUMROAD_HUMAN_OS=
VITE_GUMROAD_MEANINGFUL_LIFE=
VITE_GUMROAD_BIOLOGY_OF_OPPORTUNITY=
VITE_GUMROAD_COMPLETE_PRODUCT=

# Optional first framework SKU
VITE_GUMROAD_FRAMEWORK_DECIDE_THEN_BUILD=
